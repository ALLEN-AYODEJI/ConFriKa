{
  "manifest_version": 3,
  "name": "ConFriKa Sign — live sign to speech",
  "version": "0.1.0",
  "description": "Sign in web video calls: your signing is read from the camera and turned into speech and captions, powered by ConFriKa.",
  "action": { "default_title": "ConFriKa Sign — open panel" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
